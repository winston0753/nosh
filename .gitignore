# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Environment files — ignore all variants, keep only .example templates
.env
.env.*
!.env.example
!**/.env.example

*.sqlite
.DS_Store

# Node / JavaScript — ignore everywhere, not just inside apps/mobile/
node_modules/
.expo/
dist/
.next/
.nuxt/

# Build artifacts
build/

# Claude Code agent-local memory — not for public repository
memory/

# Local working material — kept on disk, not in the repository
# Pilot crawl data (generated, unreviewed third-party menu content)
/data/pilot/
# Personal research reports and notes
/reports/
/research_notes/
# Third-party agent skills installed locally
/.agents/
/skills-lock.json
# Claude Code per-user settings (project skills in .claude/skills/ are committed)
.claude/settings.local.json
