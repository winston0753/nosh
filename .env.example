# Nosh local development environment
# Copy to services/api/.env and fill in values. Never commit .env.

# ------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------
# Controls which auth adapters are permitted.
# Values: local | test | production
APP_ENVIRONMENT=local

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# For Docker Compose local dev:
DATABASE_URL=postgresql+asyncpg://nosh:nosh_dev@localhost:5432/nosh_dev

# For Supabase (production/shared dev):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# AUTH_LOCAL_DEV=true: accept a raw UUID as Bearer token.
# Only permitted when APP_ENVIRONMENT=local or test AND
# DATABASE_URL points to localhost, 127.0.0.1, or ::1.
# MUST be false (absent) in any deployed environment.
AUTH_LOCAL_DEV=true

# Supabase credentials — required when AUTH_LOCAL_DEV=false.
# SUPABASE_URL is always required in production (for issuer verification).
#
# Recommended (asymmetric signing keys, verified via the project JWKS):
#   SUPABASE_URL=https://<project>.supabase.co
#   SUPABASE_JWT_SECRET=   (leave empty — no shared secret needed)
#
# Legacy only (projects still on the shared HS256 JWT secret):
#   SUPABASE_URL=https://<project>.supabase.co
#   SUPABASE_JWT_SECRET=<legacy JWT secret>
#
# The mobile app uses only the project URL and the publishable key; it never
# receives SUPABASE_JWT_SECRET or a service-role/secret key.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------
# CORS (native mobile app does not need CORS)
# ------------------------------------------------------------------
# Comma-separated list of allowed origins for web/browser clients.
# Leave empty to disable CORS middleware entirely (correct for native apps).
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
LOG_LEVEL=INFO
