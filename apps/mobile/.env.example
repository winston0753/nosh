# Copy to apps/mobile/.env.local (git-ignored). Expo inlines EXPO_PUBLIC_* at build time,
# so only client-safe values belong here — never a secret or service-role key.

# FastAPI base URL.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase passwordless sign-in. Set both, or neither for local-dev UUID sign-in.
# With both set, the API must run with AUTH_LOCAL_DEV=false and the same SUPABASE_URL.
# Project API URL (https://<project-ref>.supabase.co), not the dashboard URL.
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), client-safe by design.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
